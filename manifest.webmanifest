{
  "name": "Life RPG",
  "short_name": "Life RPG",
  "description": "Diario personal gamificado: registra actividades, gana XP, sube de nivel y mantén tus rachas.",
  "lang": "es",
  "id": "./",
  "start_url": "./#dashboard",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0c0a12",
